<h1>Fresh from the kiosk</h1>

<%= form_with url: root_path, method: :get, class: "search" do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: "Search vegetables…" %>
  <%= form.submit "Search" %>
<% end %>

<div class="grid">
  <% @products.each do |product| %>
    <div class="card">
      <div class="thumb"><%= product.emoji %></div>
      <h3><%= product.name %></h3>
      <div class="unit">per <%= product.unit %></div>
      <div class="price"><%= rupees(product.price) %></div>
      <footer>
        <% if product.stock.zero? %>
          <p class="out">Out of stock</p>
        <% else %>
          <%= render "carts/stepper", product: product %>
        <% end %>
      </footer>
    </div>
  <% end %>
</div>

<% if @products.empty? %>
  <div class="empty">
    <div class="thumb">🧺</div>
    <p>Nothing matches “<%= params[:q] %>”.</p>
    <%= link_to "See everything", root_path %>
  </div>
<% end %>
