<h1>Your basket</h1>

<% products = Product.where(id: cart.keys).order(:name) %>
<% if products.empty? %>
  <div class="empty">
    <div class="thumb">🧺</div>
    <p>Your basket is empty.</p>
    <%= link_to "Browse vegetables", root_path, class: "button" %>
  </div>
<% else %>
  <div class="panel">
    <% total = 0 %>
    <% products.each do |product| %>
      <% quantity = cart[product.id.to_s].to_i %>
      <% total += product.price * quantity %>
      <div class="line">
        <div class="thumb"><%= product.emoji %></div>
        <div class="name">
          <%= product.name %><br>
          <small><%= rupees(product.price) %> per <%= product.unit %></small>
        </div>
        <%= render "carts/stepper", product: product %>
        <div class="amount"><%= rupees(product.price * quantity) %></div>
      </div>
    <% end %>
    <div class="total"><span>Total</span><span><%= rupees(total) %></span></div>
  </div>

  <div class="actions">
    <%= link_to "Checkout", new_order_path, class: "button" %>
    <%= button_to "Empty basket", cart_path, method: :delete, class: "button-quiet" %>
  </div>
<% end %>
