<h1>Order #<%= @order.id %></h1>
<p><span class="pill"><%= @order.status.humanize %></span> <small><%= @order.created_at.to_fs(:long) %></small></p>

<div class="panel">
  <% @order.order_items.includes(:product).each do |item| %>
    <div class="line">
      <div class="thumb"><%= item.product.emoji %></div>
      <div class="name"><%= item.product.name %><br><small>× <%= item.quantity %></small></div>
      <div class="amount"><%= rupees(item.subtotal) %></div>
    </div>
  <% end %>
  <div class="total"><span>Total</span><span><%= rupees(@order.total) %></span></div>
</div>

<div class="panel">
  <strong>Delivering to</strong>
  <p><%= @order.address %></p>
</div>

<%= link_to "All orders", orders_path %>
