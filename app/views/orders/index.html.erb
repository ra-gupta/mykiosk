<h1>Your orders</h1>

<% if @orders.empty? %>
  <div class="empty">
    <div class="thumb">🧾</div>
    <p>No orders yet.</p>
    <%= link_to "Start shopping", root_path, class: "button" %>
  </div>
<% end %>

<% @orders.each do |order| %>
  <div class="panel">
    <div class="line">
      <div class="name">
        <%= link_to "Order ##{order.id}", order %><br>
        <small><%= order.created_at.to_fs(:long) %></small>
      </div>
      <span class="pill"><%= order.status.humanize %></span>
      <div class="amount"><%= rupees(order.total) %></div>
    </div>
  </div>
<% end %>
