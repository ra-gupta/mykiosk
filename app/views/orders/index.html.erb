<h1 class="mb-6 text-2xl font-bold tracking-tight">Your orders</h1>

<% if @orders.empty? %>
  <div class="card p-12 text-center">
    <p class="text-5xl">🧾</p>
    <p class="mt-3 text-slate-500">No orders yet.</p>
    <p class="mt-4"><%= link_to "Start shopping", root_path, class: "btn" %></p>
  </div>
<% end %>

<div class="space-y-3">
  <% @orders.each do |order| %>
    <div class="card flex flex-wrap items-center gap-4 p-4">
      <div class="min-w-40 flex-1">
        <%= link_to "Order ##{order.id}", order, class: "font-semibold text-slate-900 hover:underline" %>
        <p class="text-xs text-slate-500">
          <%= order.created_at.to_fs(:long) %> · <%= order.city %> · <%= order.delivery_promise %>
        </p>
      </div>
      <span class="pill"><%= order.status.humanize %></span>
      <span class="w-24 text-right font-semibold"><%= rupees(order.total) %></span>
      <%= button_to "Reorder", reorder_order_path(order), class: "btn-quiet" %>
    </div>
  <% end %>
</div>
