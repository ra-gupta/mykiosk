<div class="card p-5" id="<%= dom_id(order) %>" data-controller="new-order"
     data-new-order-title-value="New order #<%= order.id %> · <%= rupees(order.total) %>">
  <div class="flex items-center justify-between gap-3">
    <p class="font-semibold">Order #<%= order.id %></p>
    <span class="pill"><%= order.status.humanize %></span>
  </div>
  <p class="mt-1 text-xl font-bold"><%= rupees(order.total) %></p>
  <p class="text-xs text-slate-500"><%= order.user.display_name %> · <%= order.created_at.to_fs(:short) %></p>

  <ul class="mt-3 space-y-1 text-sm text-slate-600">
    <% order.order_items.each do |item| %>
      <li><%= item.product.emoji %> <%= item.product.name %> × <%= item.quantity %></li>
    <% end %>
  </ul>

  <address class="mt-3 border-t border-slate-100 pt-3 text-xs not-italic text-slate-500">
    <%= order.address %>
  </address>
</div>
