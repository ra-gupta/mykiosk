<div class="auth">
  <h1>Create your account</h1>

  <%= form_with model: @user, url: registration_path, class: "panel" do |form| %>
    <% if @user.errors.any? %>
      <p class="flash alert"><%= @user.errors.full_messages.to_sentence %></p>
    <% end %>
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    <%= form.label :password_confirmation, "Confirm password" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    <%= form.submit "Sign up" %>
  <% end %>

  <p style="text-align:center">
    <%= link_to "Already have an account? Sign in", new_session_path %>
  </p>
</div>
